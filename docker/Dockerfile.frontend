# syntax=docker/dockerfile:1
# =====================================================================
# TasteLink 前端镜像（多阶段：Node 构建 + nginx 提供静态 + /api 反代后端）
# 构建上下文 = 仓库根（见 docker/docker-compose.yml 的 `--project-directory .`）
# =====================================================================
ARG NODE_IMAGE=node:20-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine

# ---- 1) 构建：vite build → dist/ ----
FROM ${NODE_IMAGE} AS build
WORKDIR /build
# package-lock 存在用 ci，否则 install
COPY frontend/package.json frontend/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY frontend/ ./
# 后端基址：默认 /api/v1（相对，由 nginx 同源反代 /api → backend:8080）
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build      # tsc -b && vite build → dist/

# ---- 2) 运行：nginx 静态 + 反代 ----
FROM ${NGINX_IMAGE} AS runtime
COPY --from=build /build/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
