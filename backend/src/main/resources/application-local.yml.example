# =====================================================================
# 本地覆盖配置示例 —— 复制为 application-local.yml 后填入真实凭据。
# application-local.yml 已被 .gitignore 排除，不会提交，请勿改本示例文件。
# =====================================================================
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/tastelink?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: YOUR_LOCAL_DB_PASSWORD
  # v2 Phase A：本地 Redis（docker compose up -d redis 起一个无密码实例即可）
  data:
    redis:
      host: localhost
      port: 6379
      password: # 无密码留空；若用 --requirepass 则填入
  # v2 Phase C：本地 RabbitMQ（docker compose up -d rabbitmq 起默认 guest/guest 实例）
  rabbitmq:
    host: localhost
    port: 5672
    username: guest
    password: guest
    virtual-host: /
  # v2 Phase D：本地 Elasticsearch（docker compose up -d elasticsearch 起单节点，9200）
  elasticsearch:
    uris: http://localhost:9200

tastelink:
  jwt:
    secret: please-replace-with-a-long-random-secret-string-at-least-32-chars-long
  # 切换为 OSS 时填写：
  storage:
    type: oss
    oss:
      endpoint: oss-cn-hangzhou.aliyuncs.com
      access-key-id: YOUR_OSS_AK
      access-key-secret: YOUR_OSS_SK
      bucket: your-bucket-name
      domain: https://your-bucket.oss-cn-hangzhou.aliyuncs.com
  # 想临时关闭热度缓存、回退纯 MySQL 排序时设为 false
  rank:
    cache-enabled: true
  # v2 Phase C：店铺删除延时清理；RABBIT_ENABLED=false 则走对账调度直接清理（无 broker 也能删店）
  rabbitmq:
    enabled: true
  # v2 Phase D：店铺关键词 ES 检索；SEARCH_ENABLED=false 则 keyword 回退 MySQL LIKE（无 ES 也能跑）
  search:
    enabled: true
