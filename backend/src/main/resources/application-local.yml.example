# =====================================================================
# 本地覆盖配置示例 —— 复制为 application-local.yml 后填入真实凭据。
# application-local.yml 已被 .gitignore 排除，不会提交，请勿改本示例文件。
# =====================================================================
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/tastelink?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: YOUR_LOCAL_DB_PASSWORD

tastelink:
  jwt:
    secret: please-replace-with-a-long-random-secret-string-at-least-32-chars-long
  # 切换为 OSS 时填写：
  storage:
    type: oss
    oss:
      endpoint: oss-cn-hangzhou.aliyuncs.com
      access-key-id: YOUR_OSS_AK
      access-key-secret: YOUR_OSS_SK
      bucket: your-bucket-name
      domain: https://your-bucket.oss-cn-hangzhou.aliyuncs.com
