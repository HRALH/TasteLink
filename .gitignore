**/application-local.yml
**/application-local.yaml
**/application-local.properties

# ===== 后端 =====
backend/target/
**/target/
*.log
**/logs/
# 本地存储兜底的上传目录
**/data/uploads/
**/data/uploads

# ===== 前端 =====
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.*

# ===== 数据库备份 / 导出 =====
*.sql.bak
*.dump
*.dump.gz
